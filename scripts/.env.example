# Deploy configuration for deploy_via_rpi.{sh,bat}
#
# Copy this file to scripts/.env and fill in real values:
#     cp scripts/.env.example scripts/.env
#
# scripts/.env is gitignored -- do not commit it (holds internal hostnames/IPs).
# Environment variables set before running work too; the .env file wins.

# --- REQUIRED ---
# Hostname, IP, or a Host alias from ~/.ssh/config for the Raspberry Pi
# with the ST-Link attached.
RPI_HOST=raspberrypi.local

# --- OPTIONAL (defaults shown) ---
RPI_USER=pi
RPI_PORT=22

# Staging directory on the Pi
RPI_REMOTE_DIR=/tmp/stm32-firmware

# Flash base address -- keep 0x08000000 for every STM32F1
FLASH_ADDR=0x08000000

# Local build directory, relative to the project root
BUILD_DIR=build
